#!/bin/bash
set -e

if [ $# -ne 3 ]; then
  echo "Usage: manhwa-scrape <platform> <manhwa_url> <output_directory>"
  echo ""
  echo "Scrapes all chapters of a manhwa from supported platforms as PDFs."
  echo ""
  echo "Arguments:"
  echo "  platform  'omegascans' or 'asurascans'"
  echo "  url       URL of the manhwa series page"
  echo "  output    Directory where the manhwa folder will be created"
  echo ""
  echo "Examples:"
  echo "  manhwa-scrape omegascans  https://omegascans.org/series/new-town-massage  /data/downloads"
  echo "  manhwa-scrape asurascans  https://asurascans.com/comics/immortals-way-of-life-9a7a1ac5  /data/downloads"
  exit 1
fi

PLATFORM="$1"
MANHWA_URL="$2"
BASE_OUTPUT="$3"
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
mkdir -p "$BASE_OUTPUT"

###############################################################################
# OMEGA SCANS
###############################################################################
fetch_omega_series() {
  local url="$1"
  local slug
  slug=$(echo "$url" | sed 's|/series/| |' | awk '{print $2}' | sed 's|/$||;s|/||g')

  local series_json
  series_json=$(curl -sL -A "$UA" "https://api.omegascans.org/series/$slug")
  local title
  title=$(echo "$series_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('title','Unknown'))" 2>/dev/null || echo "Unknown")
  local series_id
  series_id=$(echo "$series_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',0))" 2>/dev/null || echo "0")

  echo "$title|$series_id|$slug"
}

omega_chapter_list() {
  local series_id="$1"
  curl -sL -A "$UA" "https://api.omegascans.org/chapter/query?series_id=$series_id" \
    | python3 -c "
import sys, json
data = json.load(sys.stdin)
chapters = data.get('data', [])
for ch in reversed(chapters):
    slug = ch.get('chapter_slug', '')
    name = ch.get('chapter_name', slug)
    ch_id = ch.get('id', 0)
    print(f'{name}|{slug}|{ch_id}')
"
}

omega_chapter_images() {
  local series_slug="$1"
  local chapter_slug="$2"
  local html
  html=$(curl -sL -A "$UA" "https://omegascans.org/series/$series_slug/$chapter_slug")
  echo "$html" | grep -oP 'src="https://media\.omegascans\.org/file/[^"]+\.(jpg|jpeg|png|webp)(\?[^"]*)?"' \
    | sed 's/src="//;s/"$//' \
    | grep '/uploads/'
}

###############################################################################
# ASURA SCANS
###############################################################################
fetch_asura_series() {
  local url="$1"
  local html
  html=$(curl -sL -A "$UA" "$url")

  # Get title from og:title or JSON-LD
  local title
  title=$(echo "$html" | grep -oP '<meta property="og:title"[^>]+content="([^"]+)"' | sed 's/.*content="//;s/".*//;s/ | Asura Scans//')
  [ -z "$title" ] && title=$(echo "$html" | grep -oP '"headline"\s*:\s*"([^"]+)"' | sed 's/.*"headline"\s*:\s*"//;s/".*//')
  [ -z "$title" ] && title="Unknown"

  echo "$title"
}

asura_chapter_list() {
  local url="$1"
  local html
  html=$(curl -sL -A "$UA" "$url")

  local slug
  slug=$(echo "$url" | sed 's|/comics/| |' | awk '{print $2}' | sed 's|/$||')

  echo "$html" \
    | grep -oP "/comics/$slug/chapter/\d+" \
    | sort -u \
    | sort -t/ -k5 -n \
    | while read -r path; do
        num=$(echo "$path" | grep -oP '\d+$')
        echo "Chapter $num|chapter/$num"
      done
}

asura_chapter_images() {
  local chapter_url="$1"
  local html
  html=$(curl -sL -A "$UA" "$chapter_url")
  echo "$html" | grep -oP 'src="https://cdn\.asurascans\.com/asura-images/chapters/[^"]+\.webp"' \
    | sed 's/src="//;s/"$//' \
    | grep -v 'covers/'
}

###############################################################################
# COMMON
###############################################################################
download_and_pdf() {
  local chapter_label="$1"
  local chapter_num="$2"
  local output_dir="$3"
  shift 3
  local img_urls=("$@")

  if [ ${#img_urls[@]} -eq 0 ]; then
    echo "  No images found."
    return 1
  fi

  local tmpdir
  tmpdir=$(mktemp -d)
  local idx=0

  echo "  Downloading ${#img_urls[@]} images..."
  for img_url in "${img_urls[@]}"; do
    idx=$((idx + 1))
    ext="${img_url##*.}"
    ext=$(echo "$ext" | sed 's/\?.*//')
    [ "$ext" != "jpg" ] && [ "$ext" != "jpeg" ] && [ "$ext" != "png" ] && [ "$ext" != "webp" ] && ext="jpg"
    curl -sL -A "$UA" "$img_url" -o "$tmpdir/page_$(printf '%04d' $idx).$ext" &
  done
  wait

  local pdf_path="$output_dir/$chapter_label.pdf"

  python3 -c "
import glob, os, tempfile
from PIL import Image
import img2pdf

files = sorted(glob.glob('$tmpdir/*.*'))
if not files:
    exit(1)

imgs = [Image.open(f) for f in files]
max_w = max(img.width for img in imgs)

outdir = tempfile.mkdtemp()
outfiles = []
for img, f in zip(imgs, files):
    if img.width != max_w:
        ratio = max_w / img.width
        new_h = int(img.height * ratio)
        img = img.resize((max_w, new_h), Image.LANCZOS)
    outpath = os.path.join(outdir, os.path.basename(f))
    # Convert to RGB and save as JPEG for reliable PDF output
    img.convert('RGB').save(outpath, 'JPEG', quality=92)
    outfiles.append(outpath)
    img.close()

with open('$pdf_path', 'wb') as f:
    f.write(img2pdf.convert(outfiles))

import shutil
shutil.rmtree(outdir, ignore_errors=True)
" && echo "  Saved: $pdf_path" || echo "  PDF conversion failed"

  rm -rf "$tmpdir"
}

###############################################################################
# MAIN
###############################################################################
case "$PLATFORM" in
  omegascans)
    echo "Fetching series info..."
    IFS='|' read -r TITLE SERIES_ID SERIES_SLUG < <(fetch_omega_series "$MANHWA_URL")

    if [ "$SERIES_ID" = "0" ] || [ -z "$SERIES_ID" ]; then
      echo "Failed to get series info."
      exit 1
    fi

    FOLDER_NAME=$(echo "$TITLE" | sed 's/[\/:*?"<>|]//g' | tr -s ' ')
    MANHWA_DIR="$BASE_OUTPUT/$FOLDER_NAME"
    mkdir -p "$MANHWA_DIR"
    echo "Manhwa: $TITLE"
    echo "Output: $MANHWA_DIR"

    echo "Fetching chapter list..."
    CHAPTERS=$(omega_chapter_list "$SERIES_ID")
    if [ -z "$CHAPTERS" ]; then
      echo "No chapters found."
      exit 1
    fi

    TOTAL=$(echo "$CHAPTERS" | wc -l)
    echo "Found $TOTAL chapters."

    I=0
    while IFS='|' read -r CH_NAME CH_SLUG _; do
      I=$((I + 1))
      CH_NUM=$(echo "$CH_NAME" | grep -oP '\d+(\.\d+)?' | tail -1)
      [ -z "$CH_NUM" ] && CH_NUM="$I"

      echo "[$I/$TOTAL] Fetching $CH_NAME..."
      IMG_URLS=()
      while IFS= read -r url; do
        [ -n "$url" ] && IMG_URLS+=("$url")
      done < <(omega_chapter_images "$SERIES_SLUG" "$CH_SLUG")

      download_and_pdf "Chapter_$CH_NUM" "$CH_NUM" "$MANHWA_DIR" "${IMG_URLS[@]}"
      sleep 1
    done <<< "$CHAPTERS"
    ;;

  asurascans)
    echo "Fetching series info..."
    TITLE=$(fetch_asura_series "$MANHWA_URL")

    FOLDER_NAME=$(echo "$TITLE" | sed 's/[\/:*?"<>|]//g' | tr -s ' ')
    MANHWA_DIR="$BASE_OUTPUT/$FOLDER_NAME"
    mkdir -p "$MANHWA_DIR"
    echo "Manhwa: $TITLE"
    echo "Output: $MANHWA_DIR"

    echo "Fetching chapter list..."
    CHAPTERS=$(asura_chapter_list "$MANHWA_URL")
    if [ -z "$CHAPTERS" ]; then
      echo "No chapters found."
      exit 1
    fi

    TOTAL=$(echo "$CHAPTERS" | wc -l)
    echo "Found $TOTAL chapters."

    BASE_URL=$(echo "$MANHWA_URL" | sed 's|/comics/.*||')
    SLUG=$(echo "$MANHWA_URL" | sed 's|/comics/| |' | awk '{print $2}' | sed 's|/$||')

    I=0
    while IFS='|' read -r CH_NAME CH_PATH _; do
      I=$((I + 1))
      CH_NUM=$(echo "$CH_PATH" | grep -oP '\d+')
      [ -z "$CH_NUM" ] && CH_NUM="$I"

      CH_URL="$BASE_URL/comics/$SLUG/$CH_PATH"
      echo "[$I/$TOTAL] Fetching $CH_NAME..."
      IMG_URLS=()
      while IFS= read -r url; do
        [ -n "$url" ] && IMG_URLS+=("$url")
      done < <(asura_chapter_images "$CH_URL")

      download_and_pdf "Chapter_$CH_NUM" "$CH_NUM" "$MANHWA_DIR" "${IMG_URLS[@]}"
      sleep 1
    done <<< "$CHAPTERS"
    ;;

  *)
    echo "Unknown platform: $PLATFORM"
    echo "Supported: omegascans, asurascans"
    exit 1
    ;;
esac

echo "Done! All chapters in: $MANHWA_DIR"
