#!/bin/bash
set -e

if [ $# -ne 2 ]; then
  echo "Usage: manhwa-scrape <manhwa_url> <output_directory>"
  echo ""
  echo "Scrapes all chapters of a manhwa from Omega Scans as PDFs."
  echo ""
  echo "Arguments:"
  echo "  url       URL of the manhwa series on Omega Scans"
  echo "  output    Directory where the manhwa folder will be created"
  echo ""
  echo "Example:"
  echo "  manhwa-scrape https://omegascans.org/series/the-beginning-after-the-end/ /data/downloads"
  exit 1
fi

exec python3 - "$1" "$2" << 'PYEOF'
import re
import sys
import os
import time
import tempfile
import subprocess
import concurrent.futures
import shutil

import requests
from bs4 import BeautifulSoup

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
}
SESSION = requests.Session()
SESSION.headers.update(HEADERS)


def get_rsc_text(url):
    resp = SESSION.get(url, timeout=30)
    resp.raise_for_status()
    html = resp.text
    matches = re.findall(r'self\.__next_f\.push\(\[1,\\"(.+?)\\"\]\)', html, re.DOTALL)
    if not matches:
        matches = re.findall(r'self\.__next_f\.push\(\[1,\\"(.+?)\\"\]\)', html)
    if not matches:
        matches = re.findall(r"self\.__next_f\.push\(\[1,'(.+?)'\]\)", html, re.DOTALL)
    if not matches:
        matches = re.findall(r'self\.__next_f\.push\(\[1,\"(.+?)\"\]\)', html, re.DOTALL)

    parts = []
    for m in matches:
        try:
            decoded = m.encode().decode('unicode_escape')
        except Exception:
            decoded = m
        parts.append(decoded)
    return "".join(parts)


def extract_chapter_count(rsc_text):
    m = re.search(r'"Total chapters"[^}]*"children"\s*:\s*"(\d+)"', rsc_text)
    if m:
        return int(m.group(1))
    return None


def extract_title(rsc_text, url):
    m = re.search(r'"children":"([^"]+)"[^}]*"className"[^}]*text-xl', rsc_text)
    if m:
        return m.group(1)
    resp = SESSION.get(url, timeout=30)
    soup = BeautifulSoup(resp.text, 'lxml')
    title_tag = soup.find('title')
    if title_tag:
        t = title_tag.text.strip()
        t = re.sub(r'\s*[-–|]\s*Omega Scans.*$', '', t).strip()
        return t
    return url.rstrip('/').split('/')[-1].replace('-', ' ').title()


def get_chapter_images(chapter_url):
    rsc_text = get_rsc_text(chapter_url)
    if not rsc_text:
        return None

    urls = re.findall(
        r'https://media\.omegascans\.org/file/[^"\'\\]+uploads/[^"\'\\]+\.(?:jpg|jpeg|png|webp)',
        rsc_text
    )

    if not urls:
        urls = re.findall(
            r'https://media\.omegascans\.org/file/[^"\'\\]+\.(?:jpg|jpeg|png|webp)',
            rsc_text
        )
        urls = [u for u in urls if '/uploads/' in u or re.search(r'/\d{4,}\.', u)]

    seen = set()
    unique = []
    for u in urls:
        if u not in seen:
            seen.add(u)
            unique.append(u)

    return unique if unique else None


def download_image(url, path):
    try:
        resp = SESSION.get(url, timeout=30)
        resp.raise_for_status()
        with open(path, 'wb') as f:
            f.write(resp.content)
        return True
    except Exception as e:
        print(f"  Failed to download {os.path.basename(url)}: {e}")
        return False


def create_pdf(image_files, pdf_path):
    if not image_files:
        return False

    if shutil.which('convert'):
        cmd = ['convert'] + image_files + ['-quality', '90', pdf_path]
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=120)
            return True
        except subprocess.CalledProcessError as e:
            err = e.stderr.decode()[:200] if e.stderr else "unknown error"
            print(f"  ImageMagick failed: {err}")

    try:
        from PIL import Image
        images = []
        for f in image_files:
            img = Image.open(f).convert('RGB')
            images.append(img)
        if images:
            images[0].save(pdf_path, save_all=True, append_images=images[1:],
                          quality=90)
            return True
    except ImportError:
        print("  PIL/Pillow not available, install it or ImageMagick")

    return False


def scrape_series(series_url, output_dir):
    os.makedirs(output_dir, exist_ok=True)

    print("Fetching series page...")

    rsc_text = get_rsc_text(series_url)
    if not rsc_text:
        print("Failed to fetch series page data")
        return False

    title = extract_title(rsc_text, series_url)
    chapter_count = extract_chapter_count(rsc_text)

    folder_name = re.sub(r'[\\/:*?"<>|]', '', title).strip()
    manhwa_dir = os.path.join(output_dir, folder_name)
    os.makedirs(manhwa_dir, exist_ok=True)

    print(f"Manhwa: {title}")
    print(f"Output: {manhwa_dir}")

    if chapter_count:
        print(f"Total chapters: {chapter_count}")

    max_chapters = chapter_count or 100
    base_url = series_url.rstrip('/')

    print(f"Scanning for chapters...")

    found_any = False
    consecutive_misses = 0
    i = 1
    while i <= max_chapters:
        slug = f"chapter-{i}"
        chapter_url = f"{base_url}/{slug}"

        print(f"[{i}] Fetching {slug}...", end=' ')
        sys.stdout.flush()

        images = get_chapter_images(chapter_url)
        if not images:
            print("not found")
            consecutive_misses += 1
            stop_after = 5 if found_any else 3
            if consecutive_misses >= stop_after:
                if found_any:
                    break
                i += 1
                continue
            i += 1
            continue

        consecutive_misses = 0
        found_any = True
        print(f"{len(images)} images")

        num_match = re.search(r'(\d+(?:\.\d+)?)', slug)
        chapter_num = num_match.group(1) if num_match else str(i)

        tmpdir = tempfile.mkdtemp()
        try:
            def dl(idx, url):
                ext = os.path.splitext(url.split('?')[0])[1] or '.jpg'
                fname = f"page_{idx:04d}{ext}"
                fpath = os.path.join(tmpdir, fname)
                if download_image(url, fpath):
                    return fpath
                return None

            image_paths = []
            with concurrent.futures.ThreadPoolExecutor(max_workers=5) as executor:
                futures = {executor.submit(dl, idx+1, url): url
                          for idx, url in enumerate(images)}
                for future in concurrent.futures.as_completed(futures):
                    result = future.result()
                    if result:
                        image_paths.append(result)

            image_paths.sort()

            if not image_paths:
                print(f"  No images downloaded for {slug}.")
                i += 1
                continue

            pdf_path = os.path.join(manhwa_dir, f"Chapter_{chapter_num}.pdf")

            print(f"  Creating PDF...", end=' ')
            sys.stdout.flush()
            if create_pdf(image_paths, pdf_path):
                print(f"Saved: {pdf_path}")
            else:
                print("FAILED")
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)

        i += 1
        time.sleep(0.5)

    if not found_any:
        print("No chapters found.")
        return False

    print(f"Done! All chapters in: {manhwa_dir}")
    return True


if __name__ == '__main__':
    success = scrape_series(sys.argv[1], sys.argv[2])
    sys.exit(0 if success else 1)
PYEOF
