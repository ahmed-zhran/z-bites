#!/bin/bash

set -e

if [ $# -ne 2 ]; then
    echo "Usage:"
    echo "  query_manhwa <cache_folder> <query>"
    exit 1
fi

CACHE_DIR="$1"
QUERY="$2"

python3 - <<PY

import os
import json
import difflib

query = "$QUERY".lower()

results = []

for file in os.listdir("$CACHE_DIR"):

    if not file.endswith(".json"):
        continue

    path = os.path.join("$CACHE_DIR", file)

    with open(path, "r") as f:
        data = json.load(f)

    chapter = file.replace(".json", "")

    best_score = 0
    best_text = ""
    best_page = 0

    for item in data:

        text = item["description"].lower()

        score = difflib.SequenceMatcher(
            None,
            query,
            text
        ).ratio()

        if score > best_score:
            best_score = score
            best_text = item["description"]
            best_page = item["page"]

    results.append({
        "chapter": chapter,
        "page": best_page,
        "score": best_score,
        "text": best_text
    })

results.sort(key=lambda x: x["score"], reverse=True)

print("")
print("Query:", query)
print("")

for r in results[:10]:

    print("=" * 60)
    print("Chapter:", r["chapter"])
    print("Page:", r["page"])
    print("Score:", round(r["score"], 3))
    print("")
    print(r["text"])
    print("")

PY
